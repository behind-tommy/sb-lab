{
  "permissions": {
    "deny": [
      "Read(.env)", "Read(.env.*)", "Edit(.env)", "Edit(.env.*)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-push.sh" }
      ] },
      { "matcher": "Edit|Write", "hooks": [
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-env.sh" }
      ] }
    ]
  }
}
